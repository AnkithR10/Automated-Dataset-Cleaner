# ==============================================================================
# FRONTEND CONFIGURATION (NEXT.JS)
# ==============================================================================

# Public API URL for communicating with FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Client Configuration (Safe to expose to frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Razorpay Client Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here


# ==============================================================================
# BACKEND CONFIGURATION (FASTAPI)
# ==============================================================================

# FastAPI Server settings
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin Configuration (DO NOT expose to frontend)
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=configs/firebase-service-account.json

# Razorpay API Secrets (DO NOT expose to frontend)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Resend Email Configuration (DO NOT expose to frontend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
